# Solana Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Replace with your deployed program ID
NEXT_PUBLIC_PROGRAM_ID=FunMktPumpXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Custom RPC endpoint (for better performance)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://your-custom-rpc.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Funmarket.pump

# ---------------------------------------------------------------------
# Privy — Google login + embedded Solana wallets
# ---------------------------------------------------------------------
# Without NEXT_PUBLIC_PRIVY_APP_ID the app still runs: Google login is
# simply not offered and everything falls back to the Solana wallet
# adapter, exactly as before Privy.

# Public. From the Privy Dashboard (App settings -> Basics).
NEXT_PUBLIC_PRIVY_APP_ID=

# Public. Only needed if you use Privy app clients to separate
# environments; leave empty otherwise.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# SERVER ONLY — never prefix this NEXT_PUBLIC_. It authenticates as your
# app to the Privy API. Required for /api/play/auth/privy.
PRIVY_APP_SECRET=

# SERVER ONLY, optional. The app's JWT verification key from the Privy
# Dashboard. Supplying it verifies access tokens locally instead of
# fetching JWKS on a cold start.
PRIVY_VERIFICATION_KEY=
